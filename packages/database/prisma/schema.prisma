generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  emailDomain         String
  country             String
  currency            String
  timezone            String
  plan                String
  status              CompanyStatus        @default(active)
  graceUntil          DateTime?
  createdAt           DateTime             @default(now())
  deletedAt           DateTime?
  logs                AuditLog[]
  branches            Branch[]
  customers           Customer[]
  movements           InventoryMovement[]
  productStocks       ProductStock[]
  products            Product[]
  electronicDocuments ElectronicDocument[]
  payments            PaymentLog[]
  purchases           Purchase[]
  sales               Sale[]
  saleItems           SaleItem[]
  subscription        Subscription?
  suppliers           Supplier[]
  users               User[]
  cashMovements       CashMovement[]

  @@index([createdAt])
}

model Product {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @db.Uuid
  productId String
  name      String
  category  String
  price     Decimal   @db.Decimal(12, 2)
  minStock  Decimal   @default(0) @db.Decimal(12, 2)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  company   Company   @relation(fields: [companyId], references: [id])

  @@unique([companyId, id])
  @@unique([companyId, productId])
  @@index([companyId])
  @@index([category])
  @@index([minStock])
  @@index([createdAt])
}

model Branch {
  id                  String               @id @default(uuid()) @db.Uuid
  companyId           String               @db.Uuid
  name                String
  address             String?
  latitude            Decimal?             @db.Decimal(10, 7)
  longitude           Decimal?             @db.Decimal(10, 7)
  timezone            String
  createdAt           DateTime             @default(now())
  deletedAt           DateTime?
  company             Company              @relation(fields: [companyId], references: [id])
  customers           Customer[]
  movements           InventoryMovement[]
  productStocks       ProductStock[]
  electronicDocuments ElectronicDocument[]
  purchases           Purchase[]
  sales               Sale[]
  users               User[]
  cashMovements       CashMovement[]

  @@unique([companyId, id])
  @@index([companyId])
  @@index([createdAt])
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  companyId           String     @db.Uuid
  branchId            String?    @db.Uuid
  role                UserRole
  email               String
  passwordHash        String
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  sessionVersion      Int        @default(0)
  refreshTokenHash    String?
  createdAt           DateTime   @default(now())
  deletedAt           DateTime?
  logs                AuditLog[]
  branch              Branch?    @relation(fields: [companyId, branchId], references: [companyId, id])
  company             Company    @relation(fields: [companyId], references: [id])

  @@unique([companyId, id])
  @@unique([companyId, email])
  @@unique([email])
  @@index([companyId])
  @@index([branchId])
  @@index([createdAt])
}

model Customer {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @db.Uuid
  branchId       String    @db.Uuid
  name           String
  documentType   String
  documentNumber String
  phone          String?
  email          String?
  address        String?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?
  branch         Branch    @relation(fields: [companyId, branchId], references: [companyId, id])
  company        Company   @relation(fields: [companyId], references: [id])
  sales          Sale[]

  @@unique([companyId, id])
  @@index([companyId])
  @@index([branchId])
  @@index([createdAt])
}

model Supplier {
  id                String         @id @default(uuid()) @db.Uuid
  companyId         String         @db.Uuid
  name              String
  tradeName         String?
  documentType      String?
  documentNumber    String?
  ruc               String?
  status            SupplierStatus @default(active)
  isRetentionAgent  Boolean        @default(false)
  appliesDetraction Boolean        @default(false)
  taxRegime         String?
  phone             String?
  email             String?
  address           String?
  department        String?
  province          String?
  district          String?
  paymentCondition  String?        @default("cash")
  creditDays        Int?
  currency          String?        @default("PEN")
  bankName          String?
  bankAccountNumber String?
  bankCci           String?
  bankAccountType   String?
  category          String?
  tags              String[]
  createdAt         DateTime       @default(now())
  deletedAt         DateTime?
  purchases         Purchase[]
  company           Company        @relation(fields: [companyId], references: [id])

  @@unique([companyId, id])
  @@index([companyId])
  @@index([createdAt])
  @@index([documentType, documentNumber])
}

model Sale {
  id                     String               @id @default(uuid()) @db.Uuid
  companyId              String               @db.Uuid
  branchId               String               @db.Uuid
  customerId             String?              @db.Uuid
  idempotencyKey         String?
  idempotencyHash        String?
  idempotencyFirstSeenAt DateTime?
  idempotencyLastSeenAt  DateTime?
  idempotencyReplayCount Int                  @default(0)
  total                  Decimal              @db.Decimal(12, 2)
  status                 String
  createdAt              DateTime             @default(now())
  deletedAt              DateTime?
  branch                 Branch               @relation(fields: [companyId, branchId], references: [companyId, id])
  company                Company              @relation(fields: [companyId], references: [id])
  customer               Customer?            @relation(fields: [companyId, customerId], references: [companyId, id])
  items                  SaleItem[]
  electronicDocuments    ElectronicDocument[]

  @@unique([companyId, id])
  @@unique([companyId, idempotencyKey])
  @@index([companyId])
  @@index([branchId])
  @@index([createdAt])
  @@index([companyId, status, deletedAt, createdAt])
  @@index([companyId, branchId, status, deletedAt, createdAt])
}

model ElectronicDocument {
  id             String                   @id @default(uuid()) @db.Uuid
  companyId      String                   @db.Uuid
  saleId         String                   @db.Uuid
  branchId       String                   @db.Uuid
  countryCode    String
  documentType   ElectronicDocumentType
  series         String
  correlative    String
  status         ElectronicDocumentStatus @default(pending)
  externalId     String?
  digestValue    String?
  cdrCode        String?
  cdrDescription String?
  payload        Json?
  response       Json?
  issuedAt       DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  deletedAt      DateTime?
  branch         Branch                   @relation(fields: [companyId, branchId], references: [companyId, id])
  company        Company                  @relation(fields: [companyId], references: [id])
  sale           Sale                     @relation(fields: [companyId, saleId], references: [companyId, id])

  @@unique([companyId, id])
  @@unique([companyId, saleId, documentType])
  @@unique([companyId, series, correlative])
  @@index([companyId])
  @@index([status, createdAt])
}

model SaleItem {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @db.Uuid
  saleId    String    @db.Uuid
  productId String
  quantity  Decimal   @db.Decimal(12, 2)
  unitPrice Decimal   @db.Decimal(12, 2)
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  company   Company   @relation(fields: [companyId], references: [id])
  sale      Sale      @relation(fields: [saleId], references: [id])

  @@unique([companyId, id])
  @@index([companyId])
  @@index([saleId])
  @@index([productId])
  @@index([createdAt])
}

model Purchase {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @db.Uuid
  branchId   String    @db.Uuid
  supplierId String?   @db.Uuid
  total      Decimal   @db.Decimal(12, 2)
  status     String
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  branch     Branch    @relation(fields: [companyId, branchId], references: [companyId, id])
  company    Company   @relation(fields: [companyId], references: [id])
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  @@unique([companyId, id])
  @@index([companyId])
  @@index([branchId])
  @@index([createdAt])
}

model InventoryMovement {
  id        String       @id @default(uuid()) @db.Uuid
  companyId String       @db.Uuid
  branchId  String       @db.Uuid
  productId String
  type      MovementType
  quantity  Decimal      @db.Decimal(12, 2)
  unitCost  Decimal      @db.Decimal(12, 2)
  createdAt DateTime     @default(now())
  deletedAt DateTime?
  branch    Branch       @relation(fields: [companyId, branchId], references: [companyId, id])
  company   Company      @relation(fields: [companyId], references: [id])

  @@unique([companyId, id])
  @@index([companyId])
  @@index([branchId])
  @@index([createdAt])
  @@index([companyId, type, deletedAt, productId, createdAt])
  @@index([companyId, branchId, type, deletedAt, productId, createdAt])
}

model ProductStock {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  branchId  String   @db.Uuid
  productId String
  quantity  Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id])
  branch    Branch   @relation(fields: [companyId, branchId], references: [companyId, id])

  @@unique([companyId, id])
  @@unique([companyId, branchId, productId])
  @@index([companyId])
  @@index([branchId])
  @@index([productId])
}

model Subscription {
  id               String        @id @default(uuid()) @db.Uuid
  companyId        String        @unique @db.Uuid
  plan             String
  status           CompanyStatus
  currentPeriodEnd DateTime
  graceUntil       DateTime?
  createdAt        DateTime      @default(now())
  deletedAt        DateTime?
  company          Company       @relation(fields: [companyId], references: [id])

  @@unique([companyId, id])
  @@index([companyId])
  @@index([createdAt])
}

model PaymentLog {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @db.Uuid
  provider   String
  amount     Decimal   @db.Decimal(12, 2)
  currency   String
  status     String
  externalId String
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  company    Company   @relation(fields: [companyId], references: [id])

  @@unique([companyId, id])
  @@index([companyId])
  @@index([createdAt])
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  userId       String   @db.Uuid
  action       String
  entity       String
  entityId     String   @db.Uuid
  previousData Json?
  newData      Json?
  createdAt    DateTime @default(now())
  company      Company  @relation(fields: [companyId], references: [id])
  user         User     @relation(fields: [userId], references: [id])

  @@unique([companyId, id])
  @@index([companyId])
  @@index([createdAt])
}

model CashMovement {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  branchId    String    @db.Uuid
  type        String
  amount      Decimal   @db.Decimal(12, 2)
  description String?
  reference   String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  branch      Branch    @relation(fields: [companyId, branchId], references: [companyId, id])
  company     Company   @relation(fields: [companyId], references: [id])

  @@unique([companyId, id])
  @@index([companyId])
  @@index([branchId])
  @@index([createdAt])
}

enum CompanyStatus {
  active
  grace
  suspended
}

enum UserRole {
  owner
  admin
  employee
  superadmin
}

enum MovementType {
  IN       @map("in")
  OUT      @map("out")
  TRANSFER @map("transfer")
}

enum ElectronicDocumentType {
  factura
  boleta
}

enum ElectronicDocumentStatus {
  pending
  processing
  accepted
  rejected
  error
  not_applicable
}

enum SupplierStatus {
  active
  inactive
}
