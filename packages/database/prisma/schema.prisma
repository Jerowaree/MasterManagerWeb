generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  active
  grace
  suspended
}

enum UserRole {
  owner
  admin
  employee
  superadmin
}

enum MovementType {
  IN @map("in")
  OUT @map("out")
  TRANSFER @map("transfer")
}

model Company {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  country     String
  currency    String
  timezone    String
  plan        String
  status      CompanyStatus @default(active)
  graceUntil  DateTime?
  createdAt   DateTime      @default(now())
  deletedAt   DateTime?
  branches    Branch[]
  users       User[]
  customers   Customer[]
  suppliers   Supplier[]
  sales       Sale[]
  purchases   Purchase[]
  movements   InventoryMovement[]
  logs        AuditLog[]
  payments    PaymentLog[]
  subscription Subscription?

  @@index([createdAt])
}

model Branch {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @db.Uuid
  name      String
  timezone  String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  company   Company   @relation(fields: [companyId], references: [id])
  users     User[]
  customers Customer[]
  sales     Sale[]
  purchases Purchase[]
  movements InventoryMovement[]

  @@index([companyId])
  @@index([createdAt])
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  branchId     String?   @db.Uuid
  role         UserRole
  email        String
  passwordHash String
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  company      Company   @relation(fields: [companyId], references: [id])
  branch       Branch?   @relation(fields: [branchId], references: [id])
  logs         AuditLog[]

  @@unique([companyId, email])
  @@index([companyId])
  @@index([branchId])
  @@index([createdAt])
}

model Customer {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @db.Uuid
  branchId       String    @db.Uuid
  name           String
  documentType   String
  documentNumber String
  phone          String?
  email          String?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?
  company        Company   @relation(fields: [companyId], references: [id])
  branch         Branch    @relation(fields: [branchId], references: [id])
  sales          Sale[]

  @@index([companyId])
  @@index([branchId])
  @@index([createdAt])
}

model Supplier {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @db.Uuid
  name      String
  ruc       String
  phone     String?
  email     String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  company   Company   @relation(fields: [companyId], references: [id])
  purchases Purchase[]

  @@index([companyId])
  @@index([createdAt])
}

model Sale {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @db.Uuid
  branchId   String    @db.Uuid
  customerId String?   @db.Uuid
  total      Decimal   @db.Decimal(12, 2)
  status     String
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  company    Company   @relation(fields: [companyId], references: [id])
  branch     Branch    @relation(fields: [branchId], references: [id])
  customer   Customer? @relation(fields: [customerId], references: [id])

  @@index([companyId])
  @@index([branchId])
  @@index([createdAt])
}

model Purchase {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @db.Uuid
  branchId   String    @db.Uuid
  supplierId String?   @db.Uuid
  total      Decimal   @db.Decimal(12, 2)
  status     String
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  company    Company   @relation(fields: [companyId], references: [id])
  branch     Branch    @relation(fields: [branchId], references: [id])
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  @@index([companyId])
  @@index([branchId])
  @@index([createdAt])
}

model InventoryMovement {
  id        String       @id @default(uuid()) @db.Uuid
  companyId String       @db.Uuid
  branchId  String       @db.Uuid
  productId String       @db.Uuid
  type      MovementType
  quantity  Decimal      @db.Decimal(12, 2)
  unitCost  Decimal      @db.Decimal(12, 2)
  createdAt DateTime     @default(now())
  deletedAt DateTime?
  company   Company      @relation(fields: [companyId], references: [id])
  branch    Branch       @relation(fields: [branchId], references: [id])

  @@index([companyId])
  @@index([branchId])
  @@index([createdAt])
}

model Subscription {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @unique @db.Uuid
  plan             String
  status           CompanyStatus
  currentPeriodEnd DateTime
  graceUntil       DateTime?
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?
  company          Company   @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([createdAt])
}

model PaymentLog {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  provider   String
  amount     Decimal  @db.Decimal(12, 2)
  currency   String
  status     String
  externalId String
  createdAt  DateTime @default(now())
  deletedAt  DateTime?
  company    Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([createdAt])
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  userId       String   @db.Uuid
  action       String
  entity       String
  entityId     String   @db.Uuid
  previousData Json?
  newData      Json?
  createdAt    DateTime @default(now())
  company      Company  @relation(fields: [companyId], references: [id])
  user         User     @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([createdAt])
}
